# ── Virtual environment ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python bytecode ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Raw datasets (never commit raw email files) ───────────────────────────────
data/raw/

# ── Trained model artefacts ───────────────────────────────────────────────────
# Remove this line once models are trained, file sizes confirmed < 100 MB,
# and you are ready to commit them for deployment.
models/*.joblib

# ── Jupyter notebook checkpoints ─────────────────────────────────────────────
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/

# ── Secrets and environment files ────────────────────────────────────────────
.env
.env.*
secrets.toml

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Build / distribution ─────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Pytest / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
